{
  "name": "shine",
  "version": "1.0.2",
  "description": "Playwright Automation Framework with BDD",
  "main": "index.js",
    "scripts": {
      "pretest": "playwright install chromium --with-deps || true",
      "tsc": "tsc -p tsconfig.json",
      "test": "cucumber-js --config cucumber.json",
      "test:dev": "npm run test --env=dev",
      "format": "prettier --write \"**/*.{ts,tsx,css,html}\""
    },
  "keywords": [
    "PM",
    "AF"
  ],
  "author": "Prashanth Marappa",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.7.0",
    "@playwright/test": "^1.44.0",
    "cucumber-html-reporter": "^7.1.1",
    "dotenv": "^16.4.5",
    "playwright": "^1.44.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }

}